# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Dataset — download from Dryad (doi:10.5061/dryad.brv15dvr9), never commit.
# The full archive is 1.54 GB; a single fig1 file is ~58 MB.
data/*.h5
*.h5

# Jupyter
.ipynb_checkpoints/

# Regenerated analysis artefacts: large, binary, and rebuilt by notebooks 03 and 04.
# The .csv tables and results/figures/*.png ARE committed, so the results stay
# readable on GitHub without downloading the data.
results/tables/*.npz
results/tables/*.npy
